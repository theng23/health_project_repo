    FROM ap_tls.tb_tls_appl_clx a

    JOIN target_cuids c
        ON c.cuid = a.cuid

    WHERE a.contract_code IS NOT NULL

    UNION ALL

    SELECT
        a.cuid,
        a.contract_code,
        a.preprocess_date,
        a.preprocess_user,
        a.process_date,
        a.process_user,
