        a.contract_code,
        a.appl_source,

        a.preprocess_date,
        a.preprocess_user,
        a.process_date,
        a.process_user

    FROM calls s

    JOIN appl_base a
        ON a.cuid = s.cuid
       AND (
            a.preprocess_user = s.username
            OR a.process_user = s.username
       )
),

/* =========================================================
   STEP 2 - BOD
   ========================================================= */
bod AS (
    SELECT
        s.cuid,
        s.username,
        s.team,

        s.call_uuid_t,
        s.time_of_call_start_t,
        s.call_type_t,
        s.record_type_t,

        s.call_uuid_t0,
        s.time_of_call_start_t0,

        s.result_step_1,

        a.contract_code,
        a.appl_source,

        a.preprocess_date AS bod1_date,
        a.process_date AS bod2_date,

        CASE
            WHEN a.preprocess_user = s.username
                THEN a.preprocess_user
        END AS bod1_username,

        CASE
            WHEN a.process_user = s.username
                THEN a.process_user
        END AS bod2_username,

        CASE
            WHEN a.preprocess_user = s.username
             AND a.preprocess_date >= s.time_of_call_start_t - 30
             AND a.preprocess_date < s.time_of_call_start_t
                THEN 1
            ELSE 0
        END AS bod1_result,

        CASE
            WHEN a.process_user = s.username
             AND a.process_date >= s.time_of_call_start_t - 180
             AND a.process_date < s.time_of_call_start_t
                THEN 1
            ELSE 0
        END AS bod2_result,

        CASE
            WHEN a.process_user = s.username
             AND a.process_date IS NOT NULL
                THEN 'BOD2'

            WHEN a.preprocess_user = s.username
             AND a.preprocess_date IS NOT NULL
                THEN 'BOD1'
        END AS stage,

        CASE
            WHEN a.process_user = s.username
             AND a.process_date IS NOT NULL
                THEN a.process_date

            WHEN a.preprocess_user = s.username
             AND a.preprocess_date IS NOT NULL
                THEN a.preprocess_date
        END AS bod_date

    FROM calls s

    LEFT JOIN contract_candidates a
        ON a.cuid = s.cuid
       AND a.username = s.username
),

step2 AS (
    SELECT
        b.*,

        CASE
            WHEN b.bod1_result = 1
              OR b.bod2_result = 1
                THEN 1
            ELSE 0
        END AS result_step_2

    FROM bod b
),

/* =========================================================
   Next application
   ========================================================= */
next_candidates AS (
    SELECT
        s.cuid,
        s.username,
        s.contract_code AS current_contract_code,
        s.bod1_date,

        a.contract_code AS next_apply_contract_code,
        a.preprocess_date AS next_apply_date,
        a.name_credit_status,
        a.appl_source AS source_code

    FROM step2 s

    JOIN appl_base a
        ON a.cuid = s.cuid
       AND a.preprocess_user = s.username
       AND a.contract_code <> s.contract_code
       AND a.preprocess_date > s.bod1_date
       AND a.preprocess_date <= SYSDATE

    WHERE s.bod1_date IS NOT NULL
),

next_ranked AS (
    SELECT
        n.*,

        ROW_NUMBER() OVER (
            PARTITION BY
                n.cuid,
                n.username,
                n.current_contract_code,
                n.bod1_date

            ORDER BY
                n.next_apply_date,
                n.next_apply_contract_code,
                n.source_code
        ) AS rn

    FROM next_candidates n
),

/* =========================================================
   STEP 3
   ========================================================= */
step3 AS (
    SELECT
        s.*,

        n.next_apply_contract_code,
        n.next_apply_date,
        n.name_credit_status,

        CASE
            WHEN s.contract_code IS NULL
              OR s.bod1_date IS NULL
              OR s.bod1_username IS NULL
              OR s.username IS NULL
                THEN 0

            WHEN s.bod1_username <> s.username
                THEN 0

            WHEN EXISTS (
                SELECT 1
                FROM appl_base h

                WHERE h.cuid = s.cuid
                  AND h.contract_code <> s.contract_code

                  AND (
                        (
                            h.preprocess_date >= s.bod1_date - 14
                            AND h.preprocess_date < s.bod1_date
                            AND (
                                h.preprocess_user <> s.username
                                OR h.preprocess_user IS NULL
                            )
                        )

                        OR

                        (
                            h.process_date >= s.bod1_date - 14
                            AND h.process_date < s.bod1_date
                            AND (
                                h.process_user <> s.username
                                OR h.process_user IS NULL
                            )
                        )
                  )
            )
                THEN 0

            ELSE 1
        END AS last_apply_14_days

    FROM step2 s

    LEFT JOIN next_ranked n
        ON n.cuid = s.cuid
       AND n.username = s.username
       AND n.current_contract_code = s.contract_code
       AND n.bod1_date = s.bod1_date
       AND n.rn = 1
),

/* =========================================================
   HR mapping
   ========================================================= */
hr AS (
    SELECT
        t.username AS op_username,
        TO_CHAR(t.time_of_call_start_t, 'YYYY-MM') AS month,
        MAX(h.sup_name) AS sup_name

    FROM t

    JOIN ap_tls.hr_tls h
        ON h.op_username = t.username
       AND h.month =
           TO_CHAR(t.time_of_call_start_t, 'YYYY-MM')

    WHERE h.sup_name IS NOT NULL

    GROUP BY
        t.username,
        TO_CHAR(t.time_of_call_start_t, 'YYYY-MM')

    HAVING COUNT(DISTINCT h.sup_name) = 1
)

/* =========================================================
   FINAL
   ========================================================= */
SELECT /*+ PARALLEL(16) */
    r.cuid,
    r.username,
    r.team,
    hr.sup_name,

    r.call_uuid_t,
    r.call_type_t,

    r.time_of_call_start_t0,
    r.time_of_call_start_t,

    r.contract_code,
    r.appl_source,

    r.stage,
    r.bod_date,

    r.time_of_call_start_t
        - r.bod_date AS follow_dates,

    r.bod1_date,
    r.bod1_username,

    r.bod2_date,
    r.bod2_username,

    r.result_step_1,

    r.bod1_result,
    r.bod2_result,
    r.result_step_2,

    r.last_apply_14_days,

    r.next_apply_contract_code,
    r.next_apply_date,
    r.name_credit_status,

    CASE
        WHEN r.last_apply_14_days = 1
            THEN 1
        ELSE 0
    END AS result_step_3,

    CASE
        WHEN r.last_apply_14_days = 1
         AND (
                r.result_step_1 = 1
                OR r.result_step_2 = 1
             )
            THEN 1
        ELSE 0
    END AS final_result

FROM step3 r

LEFT JOIN hr
    ON hr.op_username = r.username
   AND hr.month =
       TO_CHAR(r.time_of_call_start_t, 'YYYY-MM')

order by r.cuid desc, r.time_of_call_start_t desc   
