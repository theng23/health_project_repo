        ) AS rn

    FROM step2 s

    LEFT JOIN appl_base h
      ON h.cuid = s.cuid
     AND h.contract_code <> s.contract_code
     AND h.preprocess_date < s.bod1_date
),

/* =========================================================
   STEP 3
   ========================================================= */
step3 AS (
    SELECT
        s.*,

        n.next_apply_contract_code,
        n.next_apply_date,
        n.name_credit_status,

        p.prev_contract_code,
        p.prev_bod1_date,
        p.prev_bod1_username,

        CASE
            /* Current contract: BOD1  */
            WHEN s.contract_code IS NULL
              OR s.bod1_date IS NULL
              OR s.bod1_username IS NULL
              OR s.username IS NULL
            THEN 0

            /* BOD1 current contract <> current Ops */
            WHEN s.bod1_username <> s.username
            THEN 0

            /* No previous contract */
            WHEN p.prev_contract_code IS NULL
            THEN 1

            /* Previous contract same Ops */
            WHEN p.prev_bod1_username = s.username
            THEN 1

            /* Previous contract <> Ops and <= 14 days */
            WHEN s.bod1_date - p.prev_bod1_date <= 14
            THEN 0

            /* Previous contract <> Ops but > 14 days */
            ELSE 1

        END AS last_apply_14_days

    FROM step2 s

    LEFT JOIN next_ranked n
      ON n.cuid = s.cuid
     AND n.username = s.username
     AND n.current_contract_code = s.contract_code
     AND n.bod1_date = s.bod1_date
     AND n.rn = 1

    LEFT JOIN prev_contract p
      ON p.cuid = s.cuid
     AND p.username = s.username
     AND p.contract_code = s.contract_code
     AND p.bod1_date = s.bod1_date
     AND p.rn = 1
)

/* =========================================================
   HR mapping
   ========================================================= */
,hr AS (
    SELECT
        t.username AS op_username,
        TO_CHAR(t.time_of_call_start_t, 'YYYY-MM') AS month,
        MAX(h.sup_name) AS sup_name

    FROM t

    JOIN ap_tls.hr_tls h
        ON h.op_username = t.username
       AND h.month =
           TO_CHAR(t.time_of_call_start_t, 'YYYY-MM')

    WHERE h.sup_name IS NOT NULL

    GROUP BY
        t.username,
        TO_CHAR(t.time_of_call_start_t, 'YYYY-MM')

    HAVING COUNT(DISTINCT h.sup_name) = 1
)

/* =========================================================
   FINAL
   ========================================================= */
SELECT /*+ PARALLEL(16) */
    r.cuid,
    r.username,
    r.team,
    hr.sup_name,

    r.call_uuid_t,
    r.call_type_t,

    r.time_of_call_start_t0,
    r.time_of_call_start_t,

    r.contract_code,
    r.appl_source,

    r.stage,
    r.bod_date,

    r.time_of_call_start_t
        - r.bod_date AS follow_dates,

    r.bod1_date,
    r.bod1_username,

    r.bod2_date,
    r.bod2_username,

    r.result_step_1,

    r.bod1_result,
    r.bod2_result,
    r.result_step_2,

    r.last_apply_14_days,

    r.next_apply_contract_code,
    r.next_apply_date,
    r.name_credit_status,

    CASE
        WHEN r.last_apply_14_days = 1
            THEN 1
        ELSE 0
    END AS result_step_3,

    CASE
        WHEN r.last_apply_14_days = 1
         AND (
                r.result_step_1 = 1
                OR r.result_step_2 = 1
             )
            THEN 1
        ELSE 0
    END AS final_result

FROM step3 r

LEFT JOIN hr
    ON hr.op_username = r.username
   AND hr.month =
       TO_CHAR(r.time_of_call_start_t, 'YYYY-MM')

order by r.cuid desc, r.time_of_call_start_t desc   
       ;