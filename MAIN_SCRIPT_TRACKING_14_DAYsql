   ========================================================= */
appl_base AS (
    SELECT /*+ MATERIALIZE */
        a.cuid,
        a.contract_code,
        a.preprocess_date,
        a.preprocess_user,
        a.process_date,
        a.process_user,
        a.name_credit_status,
